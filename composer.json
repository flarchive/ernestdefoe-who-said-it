{
    "name": "ernestdefoe/who-said-it",
    "description": "Who Said It? A daily quiz made from your forum's own posts: five real quotes, four members each, pick who wrote it. Speed bonus, streaks, a shareable result grid, daily and all-time leaderboards, and yesterday's answers.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "quiz",
        "daily",
        "game",
        "engagement",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/who-said-it",
    "support": {
        "issues": "https://github.com/ernestdefoe/who-said-it/issues",
        "source": "https://github.com/ernestdefoe/who-said-it"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\WhoSaidIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\WhoSaidIt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Who Said It?",
            "category": "feature",
            "icon": {
                "name": "fas fa-quote-left",
                "backgroundColor": "#7c3aed",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/suspend",
                "flarum/tags"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/suspend": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
